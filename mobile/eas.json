{
	"cli": {
		"version": ">= 15.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"ios": {
				"simulator": true
			}
		},
		"canary": {
			"distribution": "internal",
			"channel": "canary",
			"android": {
				"buildType": "apk"
			},
			"ios": {
				"simulator": false
			}
		},
		"production": {
			"channel": "stable",
			"android": {
				"buildType": "app-bundle"
			},
			"ios": {
				"simulator": false
			}
		}
	}
}
