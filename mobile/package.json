{
	"name": "mobile",
	"productName": "Crea-Accent Studio Mobile",
	"version": "1.2.0",
	"description": "Crea-Accent Studio — CRM, ERP, Agenda, Dossiers & Duotecno Mobile Companion (Android & iOS)",
	"main": "index.js",
	"scripts": {
		"dev": "expo start",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"expo:prebuild": "expo prebuild --no-install",
		"build": "tsc --noEmit && node scripts/build-native.mjs verify",
		"dist": "node scripts/build-native.mjs all",
		"dist:android": "node scripts/build-native.mjs android",
		"dist:ios": "node scripts/build-native.mjs ios",
		"lint": "tsc --noEmit"
	},
	"author": "Crea-Accent",
	"license": "MIT",
	"packageManager": "pnpm@11.24.0",
	"dependencies": {
		"@react-native-async-storage/async-storage": "^2.1.2",
		"expo": "~53.0.0",
		"expo-clipboard": "~7.1.0",
		"expo-haptics": "~14.1.0",
		"expo-linking": "~7.1.0",
		"expo-local-authentication": "~16.0.0",
		"expo-notifications": "~0.31.0",
		"expo-status-bar": "~2.2.0",
		"react": "^19.3.1",
		"react-native": "0.79.2",
		"react-native-safe-area-context": "5.4.0",
		"react-native-webview": "13.13.5"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@types/react": "^19.3.0",
		"typescript": "^6.0.3"
	}
}
